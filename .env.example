# =============================================================================
# Ripple Reader - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.

# -----------------------------------------------------------------------------
# 1. Deep Analysis (Insight) LLM - Multi-Provider
# -----------------------------------------------------------------------------
# Configure 1-10 providers. Each provider processes a subset of papers.
#
# Required per-provider vars:
#   INSIGHT_PROVIDER_{i}_NAME=My-Provider
#   INSIGHT_PROVIDER_{i}_TYPE=openai             # openai | anthropic
#   INSIGHT_PROVIDER_{i}_BASE_URL=https://api.provider.com/v1
#   INSIGHT_PROVIDER_{i}_API_KEY=sk-...          (or _API_KEY_1..100 for load balancing)
#   INSIGHT_PROVIDER_{i}_MODEL=model-name
#
# Optional per-provider vars:
#   INSIGHT_PROVIDER_{i}_MAX_TOKENS=65536        # 0 / unset = provider default
#   INSIGHT_PROVIDER_{i}_REASONING_EFFORT=high   # OpenAI o-series / DeepSeek-R1
#   INSIGHT_PROVIDER_{i}_IS_DIGEST=false         # mark as the summarizer/digest model
#   INSIGHT_PROVIDER_{i}_IS_COMMENT=false        # generates AI comments
#   INSIGHT_PROVIDER_{i}_ENABLED=true

# INSIGHT_PROVIDER_1_NAME=Provider-A
# INSIGHT_PROVIDER_1_TYPE=openai
# INSIGHT_PROVIDER_1_BASE_URL=https://api.provider-a.com/v1
# INSIGHT_PROVIDER_1_API_KEY=sk-...
# INSIGHT_PROVIDER_1_MODEL=model-name
# INSIGHT_PROVIDER_1_MAX_TOKENS=65536
# INSIGHT_PROVIDER_1_REASONING_EFFORT=high
# INSIGHT_PROVIDER_1_IS_DIGEST=false
# INSIGHT_PROVIDER_1_IS_COMMENT=false

# INSIGHT_PROVIDER_2_NAME=Provider-B
# INSIGHT_PROVIDER_2_TYPE=openai
# INSIGHT_PROVIDER_2_BASE_URL=https://api.provider-b.com/v1
# INSIGHT_PROVIDER_2_API_KEY=sk-...
# INSIGHT_PROVIDER_2_MODEL=model-name
# INSIGHT_PROVIDER_2_MAX_TOKENS=65536
# ... up to INSIGHT_PROVIDER_10

# The summarizer is the first provider with IS_DIGEST=true, else the first enabled one.

# Shared insight settings
INSIGHT_MAX_WORKERS=5

# -----------------------------------------------------------------------------
# 2. arXiv Search Settings
# -----------------------------------------------------------------------------
ARXIV_QUERY="cat:cs.AI OR cat:cs.CL OR cat:cs.LG OR cat:cs.IR OR cat:cs.DB OR cat:cs.NE OR cat:cs.CV"
ARXIV_MAX_RESULTS=10000
ARXIV_PAGE_SIZE=1000
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG,cs.IR,cs.DB,cs.NE,cs.CV
ARXIV_KEYWORDS=""
# Daily arXiv fetch cron expression. Format: "s m h * * *" (second minute hour day month weekday).
# Use "disabled" or leave empty to disable scheduled fetching.
# Default when unset: "0 30 14 * * *" (14:30:00 daily, UTC+8)
ARXIV_FETCH_CRON=disabled

# -----------------------------------------------------------------------------
# 3. Concurrency & Retries
# -----------------------------------------------------------------------------
LLM_MAX_WORKERS=5
# Default when unset: 48
LLM_MAX_RETRIES=10
PDF_MAX_WORKERS=20

# -----------------------------------------------------------------------------
# 4. Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/ripple_reader

# -----------------------------------------------------------------------------
# 5. Semantic Scholar API (Author Enrichment)
# -----------------------------------------------------------------------------
# Optional. Without a key, rate limit is ~1 req/s and you may hit 429 errors.
# With a key, limit increases to ~100 req/5s. Get one at:
# https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=

# -----------------------------------------------------------------------------
# 6. Web UI
# -----------------------------------------------------------------------------
# Leave empty to disable password protection.
WEB_PASSWORD="admin"
# Default: 8181
# WEB_PORT=8181

# -----------------------------------------------------------------------------
# 7. Database (optional tuning)
# -----------------------------------------------------------------------------
# Values shown are the defaults used when unset.
# DB_MAX_CONNECTIONS=50
# DB_SLOW_QUERY_MS=100

# -----------------------------------------------------------------------------
# 8. MinerU API (Figure & Table Extraction)
# -----------------------------------------------------------------------------
# Get token from: https://mineru.net/apiManage
MINERU_BASE_URL=https://mineru.net
# MINERU_API_KEY=
# Set to true or 1 to bypass MinerU server-side URL cache and force re-fetch.
# Default: false
# MINERU_NO_CACHE=true

# -----------------------------------------------------------------------------
# 9. Prompts
# -----------------------------------------------------------------------------
# Prompts are loaded from files under the prompts/ directory (file-only; there is
# no environment-variable override). Edit the files directly, or use the admin UI.
#
#   prompts/summarize.md   summary / score / tags
#   prompts/translate.md   abstract translation
#   prompts/insight.md     default deep-insight prompt
#   prompts/insight_*.md   additional insight variants (registered by filename)
#   prompts/review.md      insight review (optional; empty disables review)
#   prompts/revise.md      comment-driven revision (optional)

# -----------------------------------------------------------------------------
# 10. Insight Review (optional)
# -----------------------------------------------------------------------------
# Number of review attempts per insight generation. Set to 1 to disable retry on unqualified review.
# Default: 1
INSIGHT_REVIEW_MAX_ATTEMPTS=1

# Whether to automatically run review after insight generation.
# Set to false or 0 to disable auto-review. Users can still manually trigger review from the Web UI.
# Default: true
AUTO_REVIEW_INSIGHT=false
